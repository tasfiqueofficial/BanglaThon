# পূর্ণ বাংলা সিনট্যাক্স উদাহরণ (Native Bangla Script Example)

দেখাও "তুমি কেমন আছো"

ধরি নাম = "বাংলাদেশ"
ধরি বছর = ২০২৬
দেখাও "আমাদের দেশ: " + নাম + " (" + বছর + ")"

# ফাংশন ও শর্ত যাচাই
কাজ মৌলিক_কি(সংখ্যা) {
    যদি (সংখ্যা < ২) {
        ফেরত মিথ্যা
    }
    যদি (সংখ্যা == ২) {
        ফেরত সত্যি
    }
    যদি (সংখ্যা % ২ == ০) {
        ফেরত মিথ্যা
    }
    জন্য (ধরি ভাজক = ৩; ভাজক * ভাজক <= সংখ্যা; ভাজক += ২) {
        যদি (সংখ্যা % ভাজক == ০) {
            ফেরত মিথ্যা
        }
    }
    ফেরত সত্যি
}

ধরি মৌলিক_তালিকা = []
জন্য (ধরি ক = ১; ক <= ২০; ক += ১) {
    যদি (মৌলিক_কি(ক)) {
        যুক্তকরো(মৌলিক_তালিকা, ক)
    }
}

দেখাও "১ থেকে ২০ পর্যন্ত মৌলিক সংখ্যা: " + মৌলিক_তালিকা
দেখাও "মোট যোগফল: " + যোগ_করো(মৌলিক_তালিকা)
দেখাও "সর্বোচ্চ: " + সর্বোচ্চ(মৌলিক_তালিকা)
